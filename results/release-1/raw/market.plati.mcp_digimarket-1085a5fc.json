                ]
              }
            ]
          }
        },
        {
          "name": "get_product_from_plati_market",
          "title": "Get a product and its seller from plati.market",
          "description": "Fetch the full description of a single plati.market product plus the seller (id and name) that offers it, by product id. JSON output is requested via response_format=json.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "product_id": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  {
